[Unit]
Description=SPHEREx web viewer (loopback %i)
After=network.target

[Service]
Type=exec
DynamicUser=yes
WorkingDirectory=/opt/nsac/slots/%i
StateDirectory=spherex-%i
CacheDirectory=spherex-%i
Environment=SPHEREX_CACHE=/var/cache/spherex-%i
Environment=OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=SPHEREX_MONITOR=1
EnvironmentFile=-/opt/nsac/slots/%i/release.env
ExecStart=/opt/nsac/slots/%i/.venv/bin/python -m uvicorn server.app:app --host 127.0.0.1 --port %i --workers 1 --limit-concurrency 64 --timeout-keep-alive 5 --timeout-graceful-shutdown 15 --proxy-headers --forwarded-allow-ips 127.0.0.1 --no-access-log
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CPUQuota=200%
MemoryHigh=1536M
MemoryMax=2500M
TasksMax=64
UMask=0027

[Install]
WantedBy=multi-user.target
